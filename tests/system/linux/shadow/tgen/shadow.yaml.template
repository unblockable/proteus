general:
  stop_time: 5 min
network:
  graph:
    type: gml
    inline: |
      graph [
        directed 0
        node [
          id 0
          host_bandwidth_down "1 Gbit"
          host_bandwidth_up "1 Gbit"
        ]
        edge [
          source 0
          target 0
          latency "50 ms"
          jitter "0 ms"
          packet_loss 0.0
        ]
      ]
hosts:
  server:
    network_node_id: 0
    ip_addr: 100.0.0.1
    processes:
    - path: tgen
      environment: { OPENBLAS_NUM_THREADS: "1" }
      args: ${TGENSERVERCONF}
      start_time: 1
      expected_final_state: running
  proxy:
    network_node_id: 0
    ip_addr: 100.0.0.2
    processes:
    - path: ${PROTEUSBINPATH}
      args: --log-level trace server --listen 100.0.0.2:443 --turbo ${TURBO} ${PSFPATH}
      start_time: 60
      expected_final_state: running
  client:
    network_node_id: 0
    processes:
    - path: ${PROTEUSBINPATH}
      args: --log-level trace client --listen 127.0.0.1:1080 --connect 100.0.0.2:443 --mode ${MODE} --turbo ${TURBO} ${PSFPATH}
      start_time: 60
      expected_final_state: running
    - path: tgen
      environment: { OPENBLAS_NUM_THREADS: "1" }
      args: ${TGENCLIENTCONF}
      start_time: 120
      expected_final_state: {exited: 0}
